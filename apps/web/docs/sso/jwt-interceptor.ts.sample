import { Injectable } from '@angular/core';
import { HttpRequest, HttpHandler, HttpEvent, HttpInterceptor, HttpResponse, HttpErrorResponse } from '@angular/common/http';
import { BehaviorSubject, Observable, throwError } from 'rxjs';
import { catchError, filter, switchMap, take, tap } from 'rxjs/operators';
import { EmpInfo, UserService } from '@inx/inx-auth-lib';


const TOKEN_HEADER_KEY = 'Authorization';  // for Spring Boot back-end
@Injectable()
export class JwtInterceptor implements HttpInterceptor {
    private isRefreshing = false;
    private refreshTokenSubject: BehaviorSubject<any> = new BehaviorSubject<any>(null);
    constructor(private userService: UserService) {

    }

    /**
     * 這個方法代表一個 HTTP 請求攔截器，當發送 HTTP 請求時，
     * 可以在請求頭中添加 JWT 標頭欄位。
     * @param request HTTP 請求物件
     * @param next HTTP 請求處理程序
     * @returns 一個 Observable 物件，當收到 HTTP 回應時會傳回一個 HttpEvent 物件。
     * by ChatGPT
     */
    intercept(request: HttpRequest<any>, next: HttpHandler): Observable<HttpEvent<any>> {
        // 如果 JWT token 可用，則在 HTTP 請求頭中添加 JWT 標頭欄位
        let authReq = request;
        const token = this.userService.token;
        if (token) {
            authReq = this.addTokenHeader(request, token);
        }
        // 檢查 HTTP 請求是否為檢查授權的請求，檢查功能授權的話不需要做異常處理refreshtoken，因為只是確認權限是否足夠。
        const res = /(https?:\/\/)*.+\/Auth\/CheckAuthorize\/\d+\/[0-9a-zA-Z]*\?.*$/gm.exec(authReq.url)
        
        if (res) {
            return next.handle(authReq); // 如果是檢查授權的請求，直接發送請求，並返回收到的 HTTP 回應           
        }
        return next.handle(authReq)
        // .pipe(tap((event: HttpEvent<any>) => {
        //     if (event instanceof HttpResponse) {
        //     }
        // }))
        .pipe(catchError( error => {
            // 如果收到 HTTP 錯誤回應，並且錯誤狀態碼為 401，則處理 401 錯誤
            if (error instanceof HttpErrorResponse) {
                if (error.status === 401) {
                    return this.handle401Error(authReq, next);
                    // if (err.message.includes("Token Expired")) {
                    //     alert('token expired!');
                    //     this.userService.logOut();
                    // }
                }
            }
            return throwError(error);
        }));
    }

    /**
     * 這個私有方法會在伺服器回應 HTTP 狀態碼 401 時被呼叫。
     * 如果沒有在刷新 token，則會開始刷新 token，並在刷新完成後再次發出原始的請求。
     * 如果已經在刷新 token，則會等待新的 token 儲存後再次發出原始的請求。
     * 如果刷新 token 失敗，它會登出使用者並拋出錯誤。
     * 這個方法返回一個可觀察物件，該物件在刷新 token 完成或發生錯誤時會發出相應的事件。
     * by ChatGPT
     */    
    private handle401Error(request: HttpRequest<any>, next: HttpHandler): Observable<HttpEvent<any>> {
        if (!this.isRefreshing) {
            this.isRefreshing = true;
            this.refreshTokenSubject.next(null);
            return this.userService.refreshToken().pipe(
                switchMap((authInfo: EmpInfo) => {
                    this.isRefreshing = false;
            
                    this.refreshTokenSubject.next(authInfo.token);
                    
                    return next.handle(this.addTokenHeader(request, authInfo.token));
                }),
                catchError((err) => {
                    this.isRefreshing = false;
                    return this.userService.logOutObs()
                    .pipe(switchMap(() => {
                        return throwError(err);
                    }));
                })
            );
        }
        return this.refreshTokenSubject.pipe(
            filter(token => token !== null),
            take(1),
            switchMap((token) => next.handle(this.addTokenHeader(request, token)))
        );        
    }  
    
    private addTokenHeader(request: HttpRequest<any>, token: string) {
        /* for Spring Boot back-end */
        // return request.clone({ headers: request.headers.set(TOKEN_HEADER_KEY, 'Bearer ' + token) });
    
        /* for Node.js Express back-end */
        return request.clone({ headers: request.headers.set(TOKEN_HEADER_KEY, "Bearer " + token) });
    }    
}