<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"  
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
      autoReload="true"  
      internalLogLevel="Warn"  
      internalLogFile="internal-nlog.txt">  
  
  <targets>      
    <target xsi:type="File"   
    name="info"   
    fileName="./log/info-${shortdate}.log"  
    archiveFileName="./log/archives/{#}.zip"
    archiveNumbering="Date" archiveEvery="Day" archiveDateFormat="yyyy-MM-dd" maxArchiveFiles="14"
    enableArchiveFileCompression="true" 
        layout="${longdate}|${event-properties:item=EventId.Id}|${uppercase:${level}}|${message} ${exception}" />   
        
  </targets>  
  <rules>      
    <logger name="*" minlevel="TRACE" writeTo="info" >
        <filters defaultAction="Log">
            <!--when condition="contains('${message}', 'requestId:')" action="Ignore"/-->
            <when condition="contains('${message}', 'No authentication needed')" action="Ignore"/>
            <when condition="contains('${message}', 'user to be authorized')" action="Ignore"/>
            <!--when condition="contains('GatewayHealthCheck')" action="Ignore"/-->
        </filters>
    </logger> 
  </rules>  
</nlog>
